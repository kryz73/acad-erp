# Database URL (Postgres)
# Local: postgresql://acad_user:supersecret@localhost:5432/acad_erp_db
# Cloud (Neon, Supabase, Render): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://acad_user:supersecret@localhost:5432/acad_erp_db

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma-separated domains, or * for open)
# Vercel preview domains (*.vercel.app) are automatically permitted
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-frontend.vercel.app
